INF_FOLDER=1.4-9router
DEPLOY_ENV=dev
DATA_DIR=/home/travis/10-docker-data

# Host publish (container always listens on 20128). 20128 matches 9router defaults; Omniroute uses 22128.
NINER_HTTP_PORT=20128
# Public (Cloudflare Tunnel home-lab): https://router2.wmamedia.qzz.io
NINER_TAG=latest

# Bind mount subdir under DATA_DIR (existing lab data: 9router-data)
NINER_DATA_SUBDIR=9router-data

# Dashboard login (8+ chars). Set in Dokploy — do not commit real values in .env if shared.
NINER_ADMIN_PASSWORD=
NINER_JWT_SECRET=
NINER_CLI_TOKEN=

# Optional: Headroom RTK sidecar (see legacy labs stack)
# NINER_HEADROOM_URL=http://headroom:8787