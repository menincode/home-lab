# ARTEX on Docker (ghcr.io/jiwoochris/artex-global)
# Prefix for compose project, container names, and data directories on disk.
STACK_PREFIX=lab
DEPLOY_ENV=dev
DATA_DIR=.

ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

ARTEX_BIND=127.0.0.1
ARTEX_HTTP_PORT=8787
ARTEX_PROXY_PORT=8788
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
ARTEX_CORS_ORIGINS=
ARTEX_LANG=en