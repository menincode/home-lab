# Dokploy compose env — official ghcr.io/actions/actions-runner

# --- required: GitHub PAT (not a short-lived registration token) ---
# Classic: admin:org  |  Fine-grained: Organization self-hosted runners Read/Write
ACCESS_TOKEN=

ORG_NAME=wmastudio
RUNNER_SCOPE=org
# Only when RUNNER_SCOPE=repo:
REPO_NAME=

RUNNER_NAME=ubuntu-runner
RUNNER_LABELS=self-hosted,Linux,X64,docker,wmastudio
RUNNER_WORKDIR=_work
RUNNER_DATA_ROOT=/home/travis/11-github-runner
RUNNER_REPLICAS=1
DISABLE_AUTOMATIC_DEREGISTRATION=true

RUNNER_IMAGE=ghcr.io/actions/actions-runner:latest
# Host `getent group docker | cut -d: -f3` (often 999 or 998)
DOCKER_GID=999
