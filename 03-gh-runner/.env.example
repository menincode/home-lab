# Copy to .env and fill in before: docker stack deploy -c docker-compose.yml gh-runner
#./config.sh --url https://github.com/wmastudio --token ALNZZ7L34DHPH6YWKP63QYTK67EYU
# --- required ---
ACCESS_TOKEN=ALNZZ7L34DHPH6YWKP63QYTK67EYU
# Absolute path on the Swarm node that has label gh-runner=true
# Replicas use $RUNNER_DATA_ROOT/1, /2, /3… (Swarm Task.Slot)
RUNNER_DATA_ROOT=/home/travis/11-github-runner

# --- scale ---
RUNNER_REPLICAS=3

# --- image ---
RUNNER_IMAGE=myoung34/github-runner:latest

# --- org / runner identity (wmastudio) ---
REPO_URL=https://github.com/wmastudio
RUNNER_SCOPE=org
ORG_NAME=wmastudio
RUNNER_NAME=ubuntu-runner
RUNNER_LABELS=self-hosted,ubuntu,docker,wmastudio
RUNNER_WORKDIR=/tmp/github-runner/_work
RANDOM_RUNNER_SUFFIX=true
PREPULL=true
EXPOSE_DOCKER=true