# Values for Dokploy compose env (infra / runner)

# --- required ---
ACCESS_TOKEN=
# Absolute path on Swarm node (must exist before deploy)
RUNNER_DATA_ROOT=/home/travis/11-github-runner

# --- scale (1 while sharing one bind mount) ---
RUNNER_REPLICAS=1

# --- image ---
RUNNER_IMAGE=myoung34/github-runner:latest

# --- org ---
REPO_URL=https://github.com/wmastudio
RUNNER_SCOPE=org
ORG_NAME=wmastudio
RUNNER_NAME=ubuntu-runner
RUNNER_LABELS=self-hosted,ubuntu,docker,wmastudio
RUNNER_WORKDIR=_work
RANDOM_RUNNER_SUFFIX=true
PREPULL=true
EXPOSE_DOCKER=true
