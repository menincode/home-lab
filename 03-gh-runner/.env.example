# Dokploy compose env — myoung34/github-runner

# Auth (pick one):
# - ACCESS_TOKEN: GitHub PAT (ghp_… / github_pat_…) — Classic admin:org, or fine-grained
#   Organization self-hosted runners Read/Write. Survives restarts / re-register.
# - RUNNER_TOKEN: short-lived token from GitHub UI “Configure” (~1h). Good for first
#   register; with DISABLE_AUTOMATIC_DEREGISTRATION + volume, later restarts reuse config.
ACCESS_TOKEN=
RUNNER_TOKEN=

ORG_NAME=wmastudio
RUNNER_SCOPE=org
REPO_URL=https://github.com/wmastudio

RUNNER_NAME=ubuntu-runner
LABELS=self-hosted,Linux,X64,docker,wmastudio
RUNNER_WORKDIR=_work
RUNNER_DATA_ROOT=/home/travis/11-github-runner
RUNNER_REPLICAS=1
DISABLE_AUTOMATIC_DEREGISTRATION=true
RANDOM_RUNNER_SUFFIX=false

RUNNER_IMAGE=myoung34/github-runner:latest
