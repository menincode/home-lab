# Copy to .env on the runner host or set in Dokploy (never commit .env).
#
# Org runner (FFShopGaming): registration token from
#   https://github.com/organizations/FFShopGaming/settings/actions/runners/new
# Token expires in ~1 hour — only needed until CONFIGURED_ACTIONS_RUNNER_FILES_DIR
# has saved .runner (under runner-data/runner-N on the host).

REPO_URL=https://github.com/wmastudio
RUNNER_SCOPE=org
ORG_NAME=wmastudio
RUNNER_TOKEN=ALNZZ7OOOJQB3HIFUKVXLQDK677XA

# Built from runner/Dockerfile (Node 24 + Yarn 4.1.1). Dokploy: enable compose build.
# Override only if you push a prebuilt image to a registry.
RUNNER_IMAGE=ffshop-github-runner:latest
RUNNER_WORKDIR=/tmp/github-runner/_work
PREPULL=true
EXPOSE_DOCKER=true

# Host data root; each service mounts .../runner-N → /tmp/github-runner
# Runtime logs: .../runner-N-diag → /actions-runner/_diag (sibling folder, not runner-N/_diag)
#
# "registration has been deleted from the server" — stale .runner on disk; on host:
#   stop container → rm -f runner-data/runner-2/.runner runner-data/runner-2/.credentials*
#   set fresh RUNNER_TOKEN in Dokploy → start (re-register with --replace)
#
# Full disk: df -h && docker system prune -af --filter "until=72h"
RUNNER_DATA_ROOT=/home/travis/11-github-runner
