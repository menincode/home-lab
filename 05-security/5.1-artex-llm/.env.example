# ARTEX on Docker (ghcr.io/jiwoochris/artex-global)
SEC_FOLDER=5.1-artex-llm
DATA_DIR=/home/travis/10-docker-data

ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
